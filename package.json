{
  "name": "@ntnyq/prettier-config",
  "type": "module",
  "version": "3.1.0",
  "packageManager": "pnpm@12.4.1",
  "description": "Sharable prettier config of ntnyq.",
  "keywords": [
    "prettier",
    "prettier-config"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://github.com/ntnyq/prettier-config#readme",
  "repository": "ntnyq/prettier-config",
  "bugs": {
    "url": "https://github.com/ntnyq/prettier-config/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s lint typecheck test",
    "release:version": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "prettier": "^3.9.0"
  },
  "devDependencies": {
    "@ntnyq/prettier-config": "workspace:*",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx}": "oxlint --fix"
  }
}
